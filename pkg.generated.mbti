pub fn Zero::current_span_len(Self) -> Int32?
pub fn Zero::inner(Self) -> DynSource
pub fn Zero::inner_mut(Self) -> DynSource
pub fn Zero::into_inner(Self) -> DynSource
pub fn Zero::new(Int32, Int32) -> Self
pub fn Zero::new_samples(Int32, Int32, Int32) -> Self
pub fn Zero::next(Self) -> Double?
pub fn Zero::sample_rate(Self) -> Int32
pub fn Zero::total_duration(Self) -> @core.Duration?
pub fn Zero::try_seek(Self, @core.Duration) -> Unit raise SeekError
pub impl Source for Zero

// Type aliases
pub type ChannelCount = Int32

pub type Sample = Double

pub type SampleRate = Int32

// Traits
pub(open) trait FixedSource {
  fn next(Self) -> Double?
  fn channels(Self) -> Int32
  fn sample_rate(Self) -> Int32
  fn total_duration(Self) -> @core.Duration?
}

pub(open) trait NoiseRng {
  fn next_u64(Self) -> UInt64
}

pub(open) trait Source {
  fn next(Self) -> Double?
  fn channels(Self) -> Int32
  fn sample_rate(Self) -> Int32
  fn current_span_len(Self) -> Int32?
  fn total_duration(Self) -> @core.Duration?
  fn try_seek(Self, @core.Duration) -> Unit raise SeekError
}

pub(open) trait WavWriter {
  fn write_all(Self, Bytes) -> Unit raise ToWavError
}
pub impl WavWriter for @buffer.Buffer
